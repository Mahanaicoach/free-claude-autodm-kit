# Copy this file to .env and fill in your key.
#   cp .env.example .env
#
# Get a key: https://zernio.com/dashboard/api-keys
# (Sign up first at https://zernio.com/signup — free, no card, 2 accounts.)
#
# .env is gitignored. Never commit this key, never paste it into a post.
ZERNIO_API_KEY=sk_your_key_here

# Optional. Only change this if Zernio tells you to.
# ZERNIO_BASE_URL=https://zernio.com/api/v1
